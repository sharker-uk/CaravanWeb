  "places": [
    {
      "id": "park",
      "name": "HamptonVilla",
      "kind": "Your park",
      "x": 1055,
      "y": 205,
      "symbol": "P",
      "description": "Your caravan business sits beside Natwinch Road. The map inset is drawn from your current saved park, including expansion fields and beach access.",
      "next": "Manage pitches, land and beach development in the park view."
    },
    {
      "id": "village",
      "name": "The High Street",
      "kind": "Village centre",
      "x": 858,
      "y": 780,
      "symbol": "S",
      "description": "A tight mix of cottages, village shops, a pub and QuickStop. Park guests and residents share the same streets.",
      "next": "A foundation for local spending, deliveries and resident relationships."
    },
    {
      "id": "church",
      "name": "Church Lane narrows",
      "kind": "Traffic pinch point",
      "x": 790,
      "y": 535,
      "symbol": "!",
      "description": "A single-lane stretch beside the church. Alternating signals hold traffic; cars leave a gap and wait for the opposite direction to clear.",
      "next": "Watch the queue during a holiday changeover or bypass works."
    },
    {
      "id": "shore",
      "name": "The beach village",
      "kind": "Coastal quarter",
      "x": 1225,
      "y": 865,
      "symbol": "B",
      "description": "Fishing cottages, a lifeboat house, a small promenade and the long sandy beach. Beach Road links this quarter to the High Street.",
      "next": "The village beach is public. Your park's direct beach entrance remains a separate upgrade."
    },
    {
      "id": "green",
      "name": "Kingfisher Green",
      "kind": "Village life",
      "x": 1080,
      "y": 510,
      "symbol": "G",
      "description": "A village playing field and pavilion, with a school and residential lanes nearby. Open space gives the village room to breathe.",
      "next": "A setting for community events and future village relationships."
    },
    {
      "id": "fort",
      "name": "Old fort meadow",
      "kind": "Heritage & countryside",
      "x": 510,
      "y": 425,
      "symbol": "F",
      "description": "Low stone remains and a grassy meadow beside Fen Road. A small landmark beyond the holiday park gates.",
      "next": "Kept as a village destination in this first map."
    },
    {
      "id": "transport",
      "name": "West field",
      "kind": "Future transport site",
      "x": 485,
      "y": 930,
      "symbol": "T",
      "description": "An undeveloped plot near the bypass. This reserves space for the secure parking and shuttle or road train idea we discussed.",
      "next": "Parking purchases, fares and shuttle timetables are future work; no transport charges apply yet."
    },
    {
      "id": "bypass",
      "name": "Coast bypass",
      "kind": "Through route",
      "x": 250,
      "y": 745,
      "symbol": "\u2194",
      "description": "Through traffic can skirt the village on the western route. Closing it in the traffic study sends those journeys through the church narrows instead.",
      "next": "Use the bypass-works switch to compare the effect on queues."
    }
  ],
